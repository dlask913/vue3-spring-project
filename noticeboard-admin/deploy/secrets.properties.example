# Install as /var/lib/noticeboard-admin/config/secrets.properties on EC2.
# Java properties syntax: do not surround values with quotes; escape backslashes.
POSTGRES_HOST=replace-with-rds-endpoint
POSTGRES_PORT=5432
POSTGRES_DB=noticeboard
POSTGRES_USER=noticeboard_app
POSTGRES_PASSWORD=
MAIL_USERNAME=
MAIL_PASSWORD=
JWT_SECRET=
# Only required for ENC(...) values.
JASYPT_ENCRYPTOR_PASSWORD=
ADMIN_FRONTEND_ORIGIN=https://replace-with-cloudfront-domain
# Defaults below match the deployment script's preflight checks.
SERVER_PORT=8081
POSTGRES_SSL_ROOT_CERT=/var/lib/noticeboard-admin/config/rds-ca-bundle.pem
FIREBASE_CREDENTIALS_FILE=/var/lib/noticeboard-admin/config/firebase-service-account.json
